{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "source": "nixos",
    "padding": {
      "right": 2
    },
    "color": {
      "1": "#ffb692",
      "2": "#e6beac"
    }
  },

  "display": {
    "separator": "  "
  },

  "modules": [
    "title",
    "break",

    {
      "type": "os",
      "key": "󰣇 OS",
      "keyColor": "#ffb692"
    },

    {
      "type": "host",
      "key": "󰌢 Host",
      "keyColor": "#ffb692"
    },

    {
      "type": "kernel",
      "key": "󰒋 Kernel",
      "keyColor": "#e6beac"
    },

    {
      "type": "uptime",
      "key": "󰅐 Uptime",
      "keyColor": "#d0c890"
    },

    {
      "type": "packages",
      "key": "󰏖 Packages",
      "keyColor": "#ffb692"
    },

    {
      "type": "shell",
      "key": " Shell",
      "keyColor": "#e6beac"
    },

    {
      "type": "wm",
      "key": " WM",
      "keyColor": "#d0c890"
    },

    {
      "type": "theme",
      "key": "󰉼 Theme",
      "keyColor": "#ffb692"
    },

    {
      "type": "icons",
      "key": "󰀻 Icons",
      "keyColor": "#e6beac"
    },

    {
      "type": "cursor",
      "key": "󰇀 Cursor",
      "keyColor": "#d0c890"
    },

    {
      "type": "terminal",
      "key": " Terminal",
      "keyColor": "#ffb692"
    },

    {
      "type": "terminalfont",
      "key": "󰛖 Font",
      "keyColor": "#e6beac"
    },

    "break",

    {
      "type": "cpu",
      "key": "󰻠 CPU",
      "keyColor": "#ffb692"
    },

    {
      "type": "gpu",
      "key": "󰍛 GPU",
      "keyColor": "#e6beac"
    },

    {
      "type": "memory",
      "key": "󰑭 Memory",
      "keyColor": "#d0c890"
    },

    {
      "type": "swap",
      "key": "󰓡 Swap",
      "keyColor": "#ffb692"
    },

    {
      "type": "disk",
      "key": "󰋊 Disk",
      "keyColor": "#e6beac"
    },

    {
      "type": "battery",
      "key": "󰂄 Battery",
      "keyColor": "#d0c890"
    },

    {
      "type": "localip",
      "key": "󰩠 IP",
      "keyColor": "#ffb692"
    },

    {
      "type": "locale",
      "key": "󰌽 Locale",
      "keyColor": "#e6beac"
    },

    "break",

    {
      "type": "colors",
      "paddingLeft": 2
    }
  ]
}
